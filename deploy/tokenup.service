[Unit]
Description=TokenUp token ledger
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/tokenup
Environment=TOKENUP_BASE=/tokenup/
ExecStart=/usr/bin/php -S 127.0.0.1:8104 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tokenup
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
